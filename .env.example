# Copy to .env for local dev (never commit the real .env — it's gitignored).
# On Render these are set as service env vars instead.

# Supabase Postgres — use the pooler connection string (port 6543).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:6543/postgres

# LLM gateway (OpenAI-compatible endpoint serving a Claude model).
LLM_API_KEY=sk-live-...
LLM_BASE_URL=https://aicredits.in/v1
LLM_MODEL=anthropic/claude-haiku-4.5

# Auth — generate a strong random value for production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
